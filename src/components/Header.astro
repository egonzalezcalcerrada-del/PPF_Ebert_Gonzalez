---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslatedPath, useTranslations } from "../i18n/utils";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const homeHref = tp("/");
const links = [
	{ label: t("nav.home"), href: homeHref },
	{ label: t("nav.about"), href: `${homeHref}#nosotros` },
	{ label: t("nav.menu"), href: `${homeHref}#carta` },
];

const linkClass =
	"rounded-full px-4 py-2 text-[13px] font-semibold uppercase tracking-[0.14em] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-900 hover:bg-stone-900 hover:text-amber-50";
---

<header class="sticky top-0 z-50 border-b border-stone-900/10 bg-cream/95 backdrop-blur">
	<div class="relative mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
		<a
			href={homeHref}
			class="group flex min-w-0 items-center gap-2.5 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-900"
		>
			<span
				aria-hidden="true"
				class="grid size-9 shrink-0 place-items-center rounded-full bg-teal-900 text-amber-50 transition-transform group-hover:rotate-6"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M12 3v7M12 10c-4 0-7 2.5-7 6v1h14v-1c0-3.5-3-6-7-6Z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
					<path d="M4 20h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
				</svg>
			</span>
			<span class="min-w-0 truncate font-serif text-lg font-black tracking-tight text-stone-900">
				{t("meta.home.title")}
			</span>
		</a>

		<div class="hidden items-center text-stone-900 md:flex">
			<nav aria-label={t("nav.main")} class="flex items-center gap-1">
				{
					links.map((link) => (
						<a href={link.href} class={linkClass}>
							{link.label}
						</a>
					))
				}
			</nav>
			<span aria-hidden="true" class="mx-2 h-5 w-px bg-stone-900/15"></span>
			<span class="rounded-full border border-stone-900/15 bg-white/60 px-2 py-1">
				<LanguageSwitcher lang={lang} />
			</span>
		</div>

		<details class="relative shrink-0 md:hidden">
			<summary
				aria-label={t("nav.toggle")}
				class="cursor-pointer list-none rounded-full border border-stone-900/15 bg-white/70 p-2.5 text-stone-900 transition-colors marker:hidden hover:bg-stone-900 hover:text-amber-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-900 [&::-webkit-details-marker]:hidden"
			>
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
				</svg>
			</summary>
			<div class="absolute right-0 top-[calc(100%+0.75rem)] flex w-[min(20rem,calc(100vw-2rem))] flex-col gap-1 rounded-2xl border border-stone-900/10 bg-cream p-3 text-sm text-stone-900 shadow-xl">
				<nav aria-label={t("nav.main")} class="flex flex-col gap-1">
					{
						links.map((link) => (
							<a
								href={link.href}
								class="rounded-xl px-4 py-3 text-[13px] font-semibold uppercase tracking-[0.14em] transition-colors hover:bg-stone-900 hover:text-amber-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-900"
							>
								{link.label}
							</a>
						))
					}
				</nav>
				<div class="mt-1 border-t border-stone-900/10 px-4 pt-3 pb-1">
					<LanguageSwitcher lang={lang} />
				</div>
			</div>
		</details>
	</div>
</header>
