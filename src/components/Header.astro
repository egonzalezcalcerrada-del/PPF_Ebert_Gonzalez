---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslatedPath, useTranslations } from "../i18n/utils";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const homeHref = tp("/");
const links = [
	{ label: t("nav.home"), href: homeHref },
	{ label: t("nav.about"), href: `${homeHref}#nosotros` },
	{ label: t("nav.menu"), href: `${homeHref}#carta` },
];

const linkClass =
	"rounded px-1 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 hover:underline hover:underline-offset-4";
---

<header class="border-b border-black/10">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
		<a href={homeHref} class="rounded text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2">
			{t("meta.home.title")}
		</a>

		<nav aria-label={t("nav.main")} class="hidden items-center gap-5 text-sm md:flex">
			{
				links.map((link) => (
					<a href={link.href} class={linkClass}>
						{link.label}
					</a>
				))
			}
			<span aria-hidden="true" class="h-4 w-px bg-black/15"></span>
			<LanguageSwitcher lang={lang} />
		</nav>

		<details class="md:hidden">
			<summary
				aria-label={t("nav.toggle")}
				class="cursor-pointer list-none rounded p-2 focus-visible:outline-2 focus-visible:outline-offset-2"
			>
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
				</svg>
			</summary>
			<nav
				aria-label={t("nav.main")}
				class="absolute inset-x-4 top-14 flex flex-col gap-1 rounded-lg border border-black/10 bg-white p-4 text-sm shadow-lg"
			>
				{
					links.map((link) => (
						<a href={link.href} class={linkClass}>
							{link.label}
						</a>
					))
				}
				<div class="mt-2 border-t border-black/10 pt-2">
					<LanguageSwitcher lang={lang} />
				</div>
			</nav>
		</details>
	</div>
</header>
