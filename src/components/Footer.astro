---
import { useTranslatedPath, useTranslations } from "../i18n/utils";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const homeHref = tp("/");

const contactLinks = [
	{ label: t("footer.email"), href: `mailto:${t("footer.email")}` },
	{ label: t("footer.phone"), href: `tel:${t("footer.phone").replace(/\s/g, "")}` },
];
const infoLinks = [
	{ label: t("nav.home"), href: homeHref },
	{ label: t("nav.about"), href: `${homeHref}#nosotros` },
	{ label: t("nav.promo"), href: `${homeHref}#promociones` },
];
const foodLinks = [{ label: t("nav.menu"), href: `${homeHref}#carta` }];
const legalLinks = [t("footer.legal"), t("footer.privacy"), t("footer.cookies")];

const navLinkClass =
	"-m-1 p-1 text-amber-50/70 underline-offset-4 transition-colors hover:text-amber-50 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-300";
const contactLinkClass =
	"-mx-1 px-1 py-1 underline-offset-4 hover:text-amber-50 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-300";
const legalLinkClass =
	"-m-1 p-1 underline-offset-4 transition-colors hover:text-amber-50 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-300";
---

<footer class="bg-teal-950 text-amber-50">
	<div class="shell pt-14 pb-8 sm:pt-20">
		<div class="grid gap-10 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-4">
			<div>
				<p class="flex items-center justify-center gap-2.5 sm:justify-start">
					<span
						aria-hidden="true"
						class="grid size-10 shrink-0 place-items-center rounded-full bg-lime-300 text-teal-950"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M12 3v7M12 10c-4 0-7 2.5-7 6v1h14v-1c0-3.5-3-6-7-6Z"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
							<path d="M4 20h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						</svg>
					</span>
					<span class="font-serif text-lg font-black tracking-tight">{t("meta.home.title")}</span>
				</p>
				<p class="mt-4 text-sm leading-relaxed text-amber-50/70">{t("footer.tagline")}</p>
				<address class="mt-4 flex flex-col gap-1 text-sm text-amber-50/70 not-italic">
					<p>{t("footer.address")}</p>
					{
						contactLinks.map((link) => (
							<a href={link.href} class={contactLinkClass}>
								{link.label}
							</a>
						))
					}
				</address>
			</div>
			<nav aria-label={t("footer.infoTitle")}>
				<h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-lime-300">
					{t("footer.infoTitle")}
				</h2>
				<ul class="mt-4 flex flex-col gap-2.5 text-sm">
					{infoLinks.map((link) => (
						<li>
							<a href={link.href} class={navLinkClass}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
			<nav aria-label={t("footer.foodTitle")}>
				<h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-lime-300">
					{t("footer.foodTitle")}
				</h2>
				<ul class="mt-4 flex flex-col gap-2.5 text-sm">
					{foodLinks.map((link) => (
						<li>
							<a href={link.href} class={navLinkClass}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
			<div>
				<h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-lime-300">
					{t("footer.hoursTitle")}
				</h2>
				<p class="mt-4 text-sm leading-relaxed text-amber-50/70">{t("footer.hours")}</p>
			</div>
		</div>
		<div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-amber-50/60 sm:flex-row">
			<div class="flex items-center gap-4">
				{legalLinks.map((label) => (
					<a href="#" class={legalLinkClass}>
						{label}
					</a>
				))}
			</div>
			<p>{t("footer.rights")}</p>
		</div>
	</div>
</footer>
