---
import Placeholder from "./Placeholder.astro";

export type ImagePosition = "left" | "right";
export type SectionTone = "cream" | "white";

interface Props {
	id?: string;
	titleId?: string;
	eyebrow?: string;
	title: string;
	description: string;
	features?: string[];
	buttonText?: string;
	href?: string;
	imagePosition?: ImagePosition;
	tone?: SectionTone;
	placeholderLabel: string;
	placeholderName: string;
	placeholderRatio?: "video" | "portrait";
}

const {
	id,
	titleId,
	eyebrow,
	title,
	description,
	features = [],
	buttonText,
	href,
	imagePosition = "right",
	tone = "cream",
	placeholderLabel,
	placeholderName,
	placeholderRatio = "video",
} = Astro.props;

const showButton = buttonText && href;
const sectionClass =
	tone === "white"
		? "border-y border-stone-900/10 bg-white text-stone-900"
		: "bg-cream text-stone-900";
---

<section id={id} aria-labelledby={titleId} class={sectionClass}>
	<div class="shell section-pad">
		<div class="grid items-center gap-10 md:grid-cols-2 md:gap-12 lg:gap-16">
			<div class:list={{ "md:order-2": imagePosition === "right" }}>
				<div class="frame">
					<Placeholder label={placeholderLabel} name={placeholderName} ratio={placeholderRatio} />
				</div>
			</div>
			<div class:list={{ "md:order-1": imagePosition === "right" }}>
				{
					eyebrow && (
						<p class="eyebrow">
							<span aria-hidden="true" class="eyebrow-dot" />
							{eyebrow}
						</p>
					)
				}
				<h2
					id={titleId}
					class:list={["h-section", eyebrow && "mt-4"]}
				>
					{title}
				</h2>
				<p class="mt-4 max-w-xl text-base leading-relaxed text-stone-600 sm:text-lg">
					{description}
				</p>
				{
					features.length > 0 && (
						<ul class="mt-6 flex flex-col gap-3">
							{features.map((feature) => (
								<li class="flex items-start gap-3 text-sm font-medium text-stone-800 sm:text-base">
									<span
										aria-hidden="true"
										class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-teal-900 text-amber-50"
									>
										<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
											<path
												d="M2.5 6.2 4.8 8.5 9.5 3.5"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</span>
									{feature}
								</li>
							))}
						</ul>
					)
				}
				{
					showButton && (
						<a href={href} class="btn btn-primary mt-8">
							{buttonText}
						</a>
					)
				}
			</div>
		</div>
	</div>
</section>
