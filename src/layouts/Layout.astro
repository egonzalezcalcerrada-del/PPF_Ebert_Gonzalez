---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils";
// Cuando se configure `site` en astro.config.mjs, cambiar a:
// import { getAbsoluteLocaleUrl } from "astro:i18n";

interface Props {
	title: string;
	description: string;
	lang: "es" | "en";
}

const { title, description, lang } = Astro.props;
const t = useTranslations(lang);

// Ruta actual sin el prefijo de idioma (/es/... -> /..., /en/... -> /...)
const basePath = Astro.url.pathname.replace(/^\/(es|en)(?=\/|$)/, "") || "/";
const cleanPath = basePath.replace(/^\//, "");

// Sin `site` configurado usamos URLs relativas. Con `site`, usar
// getAbsoluteLocaleUrl("es" | "en", cleanPath || "/") para hreflang absolutos.
const esHref = getRelativeLocaleUrl("es", cleanPath || "/");
const enHref = getRelativeLocaleUrl("en", cleanPath || "/");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="alternate" hreflang="es" href={esHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={esHref} />
	</head>
	<body>
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:m-4 focus:rounded-full focus:bg-stone-900 focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-amber-50"
		>
			{t("a11y.skipLink")}
		</a>
		<Header lang={lang} />
		<main id="main-content">
			<slot />
		</main>
	</body>
</html>
